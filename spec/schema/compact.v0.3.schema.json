{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpackagedfood.org/spec/schema/compact.v0.3.schema.json",
  "title": "OpenPackagedFood Compact Agent Endpoint Document (v0.3)",
  "description": "Compiled /v1/{gtin|opf}/...json Compact Agent endpoint discriminated by resolution ('single' | 'uniform' | 'divergent' | 'inactive'). Top-level normalized and ingredients_text are forbidden in 'divergent' and 'inactive' modes.",
  "oneOf": [
    {
      "$ref": "#/$defs/CompactSingle"
    },
    {
      "$ref": "#/$defs/CompactUniform"
    },
    {
      "$ref": "#/$defs/CompactDivergent"
    },
    {
      "$ref": "#/$defs/CompactInactive"
    }
  ],
  "$defs": {
    "ProductId": {
      "type": "string",
      "pattern": "^(gtin:[0-9]{14}|opf:[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TrackKey": {
      "type": "string",
      "pattern": "^[A-Z]{2}/(default|[a-z][a-z0-9_]*:([A-Za-z0-9._-]+|\\{[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)+\\})(\\+[a-z][a-z0-9_]*:([A-Za-z0-9._-]+|\\{[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)+\\}))*)$"
    },
    "Sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "YearMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "TActiveBasis": {
      "type": "string",
      "enum": [
        "vintage_month",
        "earliest_reported_at"
      ]
    },
    "EvidenceLevel": {
      "type": "string",
      "enum": [
        "community_reported",
        "official_registry_imported",
        "verified",
        "corroborated"
      ]
    },
    "NullableEvidenceLevel": {
      "oneOf": [
        {
          "$ref": "#/$defs/EvidenceLevel"
        },
        {
          "type": "null"
        }
      ]
    },
    "EditionStatus": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "superseded",
        "discontinued",
        "retracted"
      ]
    },
    "RegulatoryProfile": {
      "type": "string",
      "enum": [
        "CN/GB28050-2011",
        "CN/GB28050-2025",
        "HK/CFS-132W",
        "AU/FSANZ-1.2.8",
        "US/FDA-NLEA",
        "EU/1169-2011",
        "JP/CAA-2015"
      ]
    },
    "Qualifier": {
      "type": "string",
      "enum": [
        "=",
        "<",
        "<=",
        ">",
        ">=",
        "~",
        "trace"
      ]
    },
    "CoreQualifier": {
      "type": "string",
      "enum": [
        "<",
        "<=",
        ">",
        ">=",
        "~",
        "trace"
      ]
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "text"
      ],
      "properties": {
        "lang": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CoreQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "qualifier": {
          "$ref": "#/$defs/CoreQualifier"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "qualifier": {
          "$ref": "#/$defs/Qualifier"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "NormalizedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "qualifier": {
          "$ref": "#/$defs/Qualifier"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "enum": [
            "reported",
            "derived",
            "regulatory_upper_bound"
          ]
        }
      }
    },
    "NormalizedLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "nutrients"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "100g",
            "100ml"
          ]
        },
        "nutrients": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NormalizedValue"
          }
        },
        "per_unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_amount",
            "nutrients"
          ],
          "properties": {
            "unit_amount": {
              "$ref": "#/$defs/Quantity"
            },
            "nutrients": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/NormalizedValue"
              }
            }
          }
        },
        "additives_ins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allergens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "declared_contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inferred_from_ingredients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "may_contain": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "QualityFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "REGULATORY_ZERO_ROUNDING_ARTIFACT",
            "DERIVED_FROM_SERVING_BASIS",
            "CARBS_TOTAL_INCLUDES_FIBER",
            "SODIUM_DERIVED_FROM_SALT",
            "SALT_DERIVED_FROM_SODIUM",
            "ENERGY_KJ_KCAL_DECLARED_MISMATCH",
            "NRV_PCT_DECLARED_MISMATCH",
            "NUTRITION_LABEL_EXEMPT"
          ]
        },
        "field": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "NutritionExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "packaged_water",
            "tea_coffee_herbs",
            "single_ingredient_unprocessed",
            "salt_vinegar_spices",
            "alcoholic_beverage",
            "small_daily_intake",
            "small_package_area"
          ]
        },
        "legal_basis": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "OriginInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "raw_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PartySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "brand_owner",
            "manufacturer",
            "commissioner",
            "importer",
            "distributor"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "plant_code": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "SpecialIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "qualifier": {
          "$ref": "#/$defs/Qualifier"
        },
        "value": {
          "$ref": "#/$defs/DecimalString"
        },
        "value_max": {
          "$ref": "#/$defs/DecimalString"
        },
        "tolerance": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "tolerance"
            ]
          },
          "then": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "value_max"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "tolerance"
            ]
          },
          "then": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "qualifier"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "value_max"
            ]
          },
          "then": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "qualifier"
              ]
            }
          }
        }
      ]
    },
    "TrackDiscriminator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "instructions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "lot_code_prefix",
            "sc_license",
            "plant_code",
            "origin",
            "packaging_code",
            "importer_sticker",
            "channel_mark",
            "other"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        }
      }
    },
    "EvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highest_active",
        "lowest_active",
        "by_edition"
      ],
      "properties": {
        "highest_active": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "lowest_active": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "by_edition": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceLevel"
          }
        }
      }
    },
    "InactiveEvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_edition"
      ],
      "properties": {
        "highest_active": {
          "$ref": "#/$defs/NullableEvidenceLevel"
        },
        "lowest_active": {
          "$ref": "#/$defs/NullableEvidenceLevel"
        },
        "by_edition": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceLevel"
          }
        }
      }
    },
    "EditionRedirects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Ulid"
      }
    },
    "EditionSummaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition_id",
        "rev",
        "track",
        "status",
        "t_active",
        "evidence_level",
        "core_fingerprint"
      ],
      "properties": {
        "edition_id": {
          "$ref": "#/$defs/Ulid"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "track": {
          "$ref": "#/$defs/TrackKey"
        },
        "status": {
          "$ref": "#/$defs/EditionStatus"
        },
        "t_active": {
          "$ref": "#/$defs/YearMonth"
        },
        "t_active_basis": {
          "$ref": "#/$defs/TActiveBasis"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "core_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "label_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ulid"
          },
          "uniqueItems": true
        },
        "packaging_code": {
          "type": "string"
        }
      }
    },
    "NutrientRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "unit"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/DecimalString"
        },
        "max": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "min_qualifier": {
          "$ref": "#/$defs/Qualifier"
        },
        "max_qualifier": {
          "$ref": "#/$defs/Qualifier"
        },
        "partial": {
          "type": "boolean"
        },
        "declared_in_variants": {
          "type": "integer",
          "minimum": 1
        },
        "total_variants": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "CommonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "nutrient_ranges_not_for_logging",
        "allergens_union",
        "differing_fields"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "100g",
            "100ml",
            "mixed"
          ]
        },
        "net_content_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CoreQuantity"
          }
        },
        "nutrient_ranges_not_for_logging": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NutrientRange"
          }
        },
        "allergens_union": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contains",
            "may_contain"
          ],
          "properties": {
            "contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "may_contain": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "additives_ins_union": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "differing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "TrackGuideItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "market"
      ],
      "properties": {
        "track": {
          "$ref": "#/$defs/TrackKey"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "edition_id": {
          "$ref": "#/$defs/Ulid"
        },
        "edition_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Ulid"
          },
          "uniqueItems": true
        },
        "label": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "discriminator": {
          "$ref": "#/$defs/TrackDiscriminator"
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        }
      }
    },
    "Disambiguation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "by_track",
            "unsplit_ambiguity",
            "mixed"
          ]
        },
        "tracks_guide": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackGuideItem"
          }
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        }
      }
    },
    "VariantSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition_id",
        "rev",
        "track",
        "evidence_level",
        "regulatory_profile",
        "core_fingerprint",
        "label_fingerprint",
        "t_active",
        "net_content",
        "normalized",
        "ingredients_text",
        "quality_flags"
      ],
      "properties": {
        "edition_id": {
          "$ref": "#/$defs/Ulid"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "track": {
          "$ref": "#/$defs/TrackKey"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "regulatory_profile": {
          "$ref": "#/$defs/RegulatoryProfile"
        },
        "core_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "label_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "t_active": {
          "$ref": "#/$defs/YearMonth"
        },
        "t_active_basis": {
          "$ref": "#/$defs/TActiveBasis"
        },
        "net_content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CoreQuantity"
          }
        },
        "serving_size": {
          "$ref": "#/$defs/CoreQuantity"
        },
        "nutrition_exemption": {
          "$ref": "#/$defs/NutritionExemption"
        },
        "origin": {
          "$ref": "#/$defs/OriginInfo"
        },
        "parties_summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartySummary"
          }
        },
        "product_standard": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packaging_code": {
          "type": "string"
        },
        "quality_grade": {
          "type": "string",
          "minLength": 1
        },
        "special_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SpecialIndicator"
          }
        },
        "shelf_life": {
          "$ref": "#/$defs/Quantity"
        },
        "storage_text": {
          "type": "string"
        },
        "normalized": {
          "$ref": "#/$defs/NormalizedLayer"
        },
        "ingredients_text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFlag"
          }
        }
      }
    },
    "CompactSingle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opf_schema",
        "id",
        "resolution",
        "active_edition_ids",
        "evidence_summary",
        "brand",
        "product_name",
        "regulatory_profile",
        "core_fingerprint",
        "net_content",
        "normalized",
        "ingredients_text",
        "quality_flags",
        "editions_summary",
        "full_url"
      ],
      "properties": {
        "opf_schema": {
          "type": "string",
          "const": "0.3"
        },
        "id": {
          "$ref": "#/$defs/ProductId"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resolution": {
          "type": "string",
          "const": "single"
        },
        "active_edition_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/Ulid"
          }
        },
        "active_tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/TrackKey"
          }
        },
        "edition_redirects": {
          "$ref": "#/$defs/EditionRedirects"
        },
        "evidence_summary": {
          "$ref": "#/$defs/EvidenceSummary"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "product_name": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "category": {
          "type": "string"
        },
        "declared_category": {
          "type": "string"
        },
        "regulatory_profile": {
          "$ref": "#/$defs/RegulatoryProfile"
        },
        "core_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "label_fingerprint": {
          "$ref": "#/$defs/Sha256Prefixed"
        },
        "t_active": {
          "$ref": "#/$defs/YearMonth"
        },
        "t_active_basis": {
          "$ref": "#/$defs/TActiveBasis"
        },
        "net_content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CoreQuantity"
          }
        },
